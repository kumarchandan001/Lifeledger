# ═══════════════════════════════════════════════════
# LifeLedger — Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════

# ─── Application ───
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL) ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lifeledger
POSTGRES_PASSWORD=lifeledger_dev_2026
POSTGRES_DB=lifeledger
DATABASE_URL=postgresql://lifeledger:lifeledger_dev_2026@localhost:5432/lifeledger?schema=public

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth (JWT) ───
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRY=7d

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Storage (S3) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=lifeledger-dev

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AI (Gemini) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROCESSING_CONCURRENCY=2
AI_MAX_RETRIES=3
AI_CONFIDENCE_AUTO_APPLY_THRESHOLD=95
AI_CONFIDENCE_REVIEW_THRESHOLD=80

# ─── Email (SES / SMTP) ───
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@lifeledger.in

# ─── SMS (MSG91) ───
MSG91_AUTH_KEY=
MSG91_SENDER_ID=LIFLED

# ─── Push Notifications (FCM) ───
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Payments (Razorpay) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Monitoring ───
SENTRY_DSN=
