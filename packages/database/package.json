{
  "name": "@lifeledger/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma ORM schema, client, and migrations",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo node_modules/.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "@lifeledger/config": "workspace:*",
    "@lifeledger/shared": "workspace:*",
    "@types/node": "^22.12.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  }
}
